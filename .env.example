# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# إعدادات قاعدة بيانات Firebase Firestore السحابية المجانية (Spark Plan - Free)
# Free Firebase Firestore Configuration (Real-time cloud database)
# ==============================================================================
# يمكنك أيضاً إدخال هذه البيانات مباشرة من شاشة المشرف (Admin Dashboard) 
# بدون الحاجة لتعديل هذا الملف إذا كنت تفضل ذلك!
#
VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="iin-store-xxxx.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="iin-store-xxxx"
VITE_FIREBASE_STORAGE_BUCKET="iin-store-xxxx.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:xxxxxxxxxxxxxxxxxxxx"
